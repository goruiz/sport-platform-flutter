# Copia este archivo a android/key.properties (ignorado por git) con los datos del keystore de subida.
# El keystore y este archivo no se versionan: si se pierden no se puede publicar una actualizacion de la app.
storePassword=contrasena-del-keystore
keyPassword=contrasena-de-la-clave
keyAlias=upload
# Ruta relativa a android/app
storeFile=upload-keystore.jks
